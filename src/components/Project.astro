---
interface Props {
  name: string;
  state: "shipped" | "killed" | "active" | "parked";
  stack: string;
  href?: string;
}

const { name, state, stack, href } = Astro.props;

const stateClass = {
  shipped: "text-shipped border-shipped/40",
  killed: "text-killed border-killed/40",
  active: "text-accent border-accent/40",
  parked: "text-parked border-parked/40",
}[state];
---

<article class="border-t border-line py-7">
  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-2">
    <h3 class="font-serif text-xl font-semibold tracking-tight text-ink">
      {href ? <a href={href} class="hover:text-accent">{name}</a> : name}
    </h3>
    <span class={`rounded-sm border px-2 py-0.5 font-mono text-[10px] font-medium tracking-widest uppercase ${stateClass}`}>
      {state}
    </span>
    <span class="ml-auto font-mono text-xs text-ink-3">{stack}</span>
  </div>
  <div class="mt-3 text-[15px] leading-relaxed text-ink-2">
    <slot />
  </div>
</article>
