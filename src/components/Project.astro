---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { name, state, kind, openSource, stack, summary } = project.data;

const stateClass = {
  shipped: "text-shipped border-shipped/40",
  killed: "text-killed border-killed/40",
  active: "text-accent border-accent/40",
  parked: "text-parked border-parked/40",
}[state];
---

<article class="border-t border-line py-6">
  <a href={`/projects/${project.id}`} class="group block">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-2">
      <h3 class="font-serif text-xl font-semibold tracking-tight text-ink group-hover:text-accent">
        {name}
      </h3>
      <span
        class={`rounded-sm border px-2 py-0.5 font-mono text-[10px] font-medium tracking-widest uppercase ${stateClass}`}
      >
        {state}
      </span>
      {
        openSource && kind !== "open-source" && (
          <span class="rounded-sm border border-line px-2 py-0.5 font-mono text-[10px] font-medium tracking-widest text-ink-3 uppercase">
            open source
          </span>
        )
      }
      <span class="ml-auto font-mono text-xs text-ink-3">{stack}</span>
    </div>
    <p class="mt-3 text-[15px] leading-relaxed text-ink-2">{summary}</p>
  </a>
</article>
