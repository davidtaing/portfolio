---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="David Taing" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="David Taing — Full Stack Engineer, Sydney" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1f3a5f" />
    {/* Self-hosted, so the font files sit on the connection that already
        served this document. Preloaded because they are all three above the
        fold and there is nothing else on the page competing for the bandwidth.
        crossorigin is required even same-origin: fonts are fetched in CORS
        mode, and without it the preload is discarded and fetched again. The
        italic faces are deliberately not preloaded — only the project and
        writing pages render italics, and the browser fetches them there. */}
    <link
      rel="preload"
      href="/fonts/source-serif-4-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-sans-3-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-panel focus:text-ink focus:px-3 focus:py-2 focus:border focus:border-line"
      >Skip to content</a
    >

    <div class="mx-auto w-full max-w-2xl px-6">
      <header class="flex items-baseline justify-between gap-4 py-7">
        <a href="/" class="font-serif text-lg font-semibold tracking-tight text-ink">David Taing</a>
        <nav class="flex items-center gap-5 font-mono text-xs tracking-widest text-ink-3 uppercase">
          <a href="/#work" class="hover:text-accent">Work</a>
          <a href="/#projects" class="hover:text-accent">Projects</a>
          <a href="/writing" class="hover:text-accent">Writing</a>
        </nav>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="mt-24 mb-14 border-t border-line pt-6 font-mono text-xs leading-relaxed text-ink-3">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
          <a href="mailto:dave@teeang.net" class="hover:text-accent">dave@teeang.net</a>
          <a href="https://github.com/davidtaing" class="hover:text-accent">GitHub</a>
          <a href="https://www.linkedin.com/in/teeang/" class="hover:text-accent">LinkedIn</a>
        </div>
        <p class="mt-2">Sydney, Australia &middot; &copy; {year}</p>
      </footer>
    </div>
  </body>
</html>
