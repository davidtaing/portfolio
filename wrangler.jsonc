// Deploy configuration for teeang.net.
//
// This lives in the repository on purpose. Without it, Cloudflare Workers
// Builds falls back to its detected Astro framework preset, which installs the
// @astrojs/cloudflare adapter and builds the site as a server application. That
// is what broke the images: the adapter's default image service is
// `passthrough`, which emits /_image?href=...&f=avif URLs for Cloudflare Images
// to answer. Cloudflare Images is not enabled on this zone, so every one of
// them returned 404 while the rest of the site looked fine.
//
// Nothing here renders at request time. There is no `main`, because there is no
// server code to point it at: `assets.directory` is the entire Worker, and
// `astro build` bakes every page, font and image variant into dist/ first. If a
// future change genuinely needs an adapter, that is a deliberate decision to
// make in astro.config.mjs, not something a build preset should infer.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "teeang-net",
  "compatibility_date": "2026-08-28",
  // Explicit because it defaults off as soon as any route is configured, which
  // silently leaves the Worker with no reachable target.
  "workers_dev": true,
  "assets": {
    "directory": "./dist"
  },
  "routes": [{ "pattern": "teeang.net", "custom_domain": true }],
  "observability": {
    "enabled": true
  }
}
